{
  "name": "continuum-ai-backend",
  "version": "0.1.0",
  "description": "Continuum AI backend services and API gateway",
  "author": "DATN Spring 2027",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run start:legacy-monolith",
    "start:legacy-monolith": "nest start",
    "start:gateway": "nest start --entryFile gateway/main",
    "start:iam": "nest start --entryFile services/iam/main",
    "start:capture": "nest start --entryFile services/capture/main",
    "start:jira": "nest start --entryFile services/jira/main",
    "start:lifecycle": "nest start --entryFile services/lifecycle/main",
    "start:chat": "nest start --entryFile services/chat/main",
    "start:handover": "nest start --entryFile services/handover/main",
    "start:ingestion": "nest start --entryFile services/ingestion/main",
    "start:notification": "nest start --entryFile services/notification/main",
    "start:worker": "nest start --entryFile workers/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:gateway:prod": "node dist/gateway/main",
    "start:worker:prod": "node dist/workers/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "dev:db:init": "node scripts/dev/initialize-service-owned-databases.mjs",
    "dev:db:smoke": "node scripts/dev/smoke-service-owned-runtime.mjs",
    "dev:platform-authority:test-adoption": "node scripts/dev/platform-authority-test-adoption.mjs",
    "test:dev-db-init": "node --test scripts/dev/initialize-service-owned-databases.test.mjs",
    "test:dev-db-smoke-safety": "node --test scripts/dev/smoke-service-owned-runtime.test.mjs",
    "test:platform-authority-adoption-safety": "node --test scripts/dev/platform-authority-test-adoption-policy.test.mjs",
    "reconcile:organization-roles": "node scripts/organization-role-reconciliation.mjs",
    "test:organization-role-reconciliation": "node --test scripts/organization-role-reconciliation.test.mjs",
    "test:organization-role-reconciliation:mongodb": "node --test scripts/organization-role-reconciliation.mongodb.test.mjs",
    "test:migrations:plan": "node --test scripts/migrations/*.plan.test.mjs",
    "test:project-access-permissions:integration": "node --test scripts/migrations/20261012-project-access-permission-provisioning.mongodb.test.mjs",
    "test:platform-incidents:migration-plan": "node --test scripts/migrations/platform-incidents.plan.test.mjs",
    "test:platform-request-trace-index:migration-plan": "node --test scripts/migrations/platform-request-trace-index.plan.test.mjs",
    "test:membership-lifecycle:integration": "node --test scripts/migrations/20261012-organization-membership-lifecycle.mongodb.test.mjs",
    "migrate:membership-lifecycle": "node scripts/migrations/20261012-organization-membership-lifecycle.mjs",
    "migrate:task-lifecycle-contract": "node scripts/migrations/20261019-task-lifecycle-contract.mjs",
    "migrate:task-deadline-scan-index": "node scripts/migrations/20261024-task-deadline-scan-index.mjs",
    "test:task-deadline-scan-index-plan": "node --test scripts/migrations/task-deadline-scan-index.plan.test.mjs",
    "migrate:notification-request-flow-indexes": "node scripts/migrations/20261024-notification-request-flow-indexes.mjs",
    "test:notification-request-flow-indexes-plan": "node --test scripts/migrations/notification-request-flow-indexes.plan.test.mjs",
    "migrate:platform-authority-change-hardening": "node scripts/migrations/20261016-platform-authority-change-hardening.mjs",
    "migrate:platform-operator-v1-expansion-index": "node scripts/migrations/20261016-platform-operator-v1-expansion-index.mjs",
    "test:platform-operator-v1-expansion-index-plan": "node --test scripts/migrations/platform-operator-v1-expansion-index.plan.test.mjs",
    "migrate:team-foundation-runtime": "node scripts/migrations/20261015-team-foundation-runtime.mjs",
    "test:team-foundation-runtime-plan": "node --test scripts/migrations/team-foundation-runtime.plan.test.mjs",
    "test:team-foundation-transactions": "node scripts/tests/team-foundation-transactions.integration.mjs",
    "test:project-audit-atomicity": "node scripts/tests/project-audit-atomicity.integration.mjs",
    "migrate:google-identity-index": "node scripts/migrations/20261011-google-identity-index.mjs",
    "migrate:platform-incidents": "node scripts/migrations/20261017-platform-incidents-storage.mjs",
    "migrate:platform-request-trace-index": "node scripts/migrations/20261017-platform-request-trace-index.mjs",
    "migrate:password-reset-outbox": "node scripts/migrations/20261014-password-reset-outbox.mjs",
    "migrate:email-registration-outbox": "node scripts/migrations/20261018-email-registration-outbox.mjs",
    "migrate:organization-invitations": "node scripts/migrations/20261011-organization-invitations.mjs",
    "migrate:organization-invitation-token-index": "node scripts/migrations/20261020-organization-invitation-token-index.mjs",
    "migrate:organization-membership-admin-permissions": "node --env-file=.env scripts/migrations/20261019-organization-membership-admin-permissions.mjs",
    "migrate:project-creator-leader": "node --env-file=.env scripts/migrations/20261019-project-creator-leader.mjs",
    "test:migrations:integration": "node --test scripts/migrations/20261002-database-per-service-split.integration.test.mjs",
    "test:capture-drafts-ttl:integration": "node --test scripts/migrations/20261003-capture-drafts-ttl.mongodb.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:organization-role-reconciliation && npm run test:dev-db-smoke-safety && npm test -- --runInBand && npm run test:e2e -- --runInBand && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.2.5",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-ws": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "2.2.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "bcryptjs": "3.0.3",
    "bullmq": "^5.81.5",
    "bullmq-otel": "^1.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.9",
    "mongoose": "^8.24.4",
    "nodemailer": "^10.1.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "multer": "2.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
