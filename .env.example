NODE_ENV=development
# JWT_SECRET is required for IAM startup; set a random value of at least 32 characters.
JWT_SECRET=
PORT=3001
GATEWAY_PORT=3000
SERVICE_PORT=3001
IAM_SERVICE_URL=http://127.0.0.1:3001
# Shared only by Gateway and IAM. Supply a distinct random value of at least 32 characters.
IAM_GATEWAY_SECRET=
# Set to the exact CIDR(s) of trusted BFF/ingress peers. Empty means forwarded IPs are ignored.
GATEWAY_TRUSTED_PROXY_CIDRS=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MODE=standalone
REDIS_CLUSTER_NODES=redis-0:6379,redis-1:6379,redis-2:6379,redis-3:6379,redis-4:6379,redis-5:6379
INFRA_ENABLED=false
# Shared MongoDB switch for the AppModule modular monolith.
MONGODB_ENABLED=false
MONGODB_URI=mongodb://127.0.0.1:27017
# Database for the shared AppModule runtime. Standalone IAM uses continuum_iam.
MONGODB_DATABASE=continuum_db
MONGODB_AUTO_INDEX=false
AUDIT_DATABASE=continuum_audit
BULLMQ_PREFIX=continuum
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKEND_TIMEOUT_MS=5000
SWAGGER_ENABLED=true
