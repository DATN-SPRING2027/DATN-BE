NODE_ENV=development
# JWT_SECRET is required for IAM startup; set a random value of at least 32 characters.
JWT_SECRET=
# Optional stable key for password-reset outbox payload encryption (32+ chars).
# If omitted, IAM derives a purpose-specific key from JWT_SECRET.
# PASSWORD_RESET_OUTBOX_KEY=
# Optional stable key for email-registration outbox payload encryption (32+ chars).
# If omitted, IAM derives a purpose-specific key from JWT_SECRET.
# EMAIL_REGISTRATION_OUTBOX_KEY=
# Leave all three Google settings blank to disable Google OAuth locally.
# When enabled, register the exact FE BFF callback URI in Google Cloud Console.
# Local FE on port 3000: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
PORT=3001
GATEWAY_PORT=3000
SERVICE_PORT=3001
IAM_SERVICE_URL=http://127.0.0.1:3001
CAPTURE_SERVICE_URL=http://127.0.0.1:3002
JIRA_SERVICE_URL=http://127.0.0.1:3003
LIFECYCLE_SERVICE_URL=http://127.0.0.1:3004
CHAT_SERVICE_URL=http://127.0.0.1:3005
HANDOVER_SERVICE_URL=http://127.0.0.1:3006
INGESTION_SERVICE_URL=http://127.0.0.1:3007
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3008
SAG_SERVICE_URL=http://127.0.0.1:8000
# Shared only by Gateway and IAM. Supply a distinct random value of at least 32 characters.
IAM_GATEWAY_SECRET=
# Shared only by IAM and Jira for signed, internal Platform integration reads.
PLATFORM_SERVICE_OPS_SECRET=
# Set to the exact CIDR(s) of trusted BFF/ingress peers. Empty means forwarded IPs are ignored.
GATEWAY_TRUSTED_PROXY_CIDRS=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MODE=standalone
REDIS_CLUSTER_NODES=redis-0:6379,redis-1:6379,redis-2:6379,redis-3:6379,redis-4:6379,redis-5:6379
INFRA_ENABLED=false
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_AUTO_INDEX=false
# Standalone service entrypoints require SERVICE_DATABASE when INFRA_ENABLED=true.
# For example, use SERVICE_DATABASE=continuum_iam for the standalone IAM process.
# The AppModule monolith uses the service-owned mapping in src/common/mongodb/database-names.ts.
# SERVICE_DATABASE=continuum_iam
BULLMQ_PREFIX=continuum
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BACKEND_TIMEOUT_MS=5000
SWAGGER_ENABLED=true
# SMTP credentials stay local; never commit a real SMTP_PASS value.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=
# Absolute public FE URL used when constructing authentication email links.
WEB_APP_URL=http://localhost:3000
