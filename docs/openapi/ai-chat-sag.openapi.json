{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Chat SAG BFF Contract",
    "version": "1.0.0",
    "description": "Approved Continuum AI BFF contract for Project-scoped AI Chat backed by SAG and SAG-ECCE. Every request enforces active Organization membership, Project read access, and CSRF validation for cookie-authenticated mutations. No SAG tokens, prompt previews, or internal tool arguments are exposed to clients."
  },
  "security": [
    {
      "cookieAuth": []
    },
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/ai-chat/projects/{projectId}/threads": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ProjectId"
        }
      ],
      "get": {
        "operationId": "listAiChatThreads",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Threads owned by the authenticated user in the selected Project",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Thread"
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createAiChatThread",
        "parameters": [
          { "$ref": "#/components/parameters/CsrfTokenHeader" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateThread"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Thread created in the selected Project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thread"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/ai-chat/projects/{projectId}/threads/{threadId}": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ThreadId" }
      ],
      "patch": {
        "operationId": "updateAiChatThread",
        "parameters": [
          { "$ref": "#/components/parameters/CsrfTokenHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateThread"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Thread updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Thread"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "deleteAiChatThread",
        "parameters": [
          { "$ref": "#/components/parameters/CsrfTokenHeader" }
        ],
        "responses": {
          "204": {
            "description": "Thread and its SAG session memory purged"
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/ai-chat/projects/{projectId}/threads/{threadId}/messages": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ThreadId" }
      ],
      "get": {
        "operationId": "listAiChatMessages",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 40
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paginated messages ordered chronologically within the page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagePage"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/ai-chat/projects/{projectId}/threads/{threadId}/ask": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ThreadId" }
      ],
      "post": {
        "operationId": "askAiChatThread",
        "parameters": [
          { "$ref": "#/components/parameters/CsrfTokenHeader" }
        ],
        "description": "POST returns text/event-stream (SSE). Validates active Organization membership, Project read access, CSRF (for cookie auth), and thread ownership before streaming. Emits allowlisted JSON events: started (StartedEvent), step (StepEvent), delta (DeltaEvent), and at most one terminal event: completed (CompletedEvent) or failed (FailedEvent). Never automatically retries paid LLM generation and never forwards prompt previews, raw upstream errors, or credentials.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ask"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream ending with completed or failed",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "event: started\ndata: {\"runId\":\"r1\",\"threadId\":\"t1\",\"userMessageId\":\"u1\"}\n\nevent: delta\ndata: {\"text\":\"Hello [1]\"}\n\nevent: completed\ndata: {\"messageId\":\"m1\",\"content\":\"Hello [1]\",\"answerStatus\":\"answered\",\"citations\":[],\"sessionCitations\":[],\"retrievalSteps\":[]}\n\n"
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/ai-chat/projects/{projectId}/threads/{threadId}/messages/{messageId}/feedback": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ThreadId" },
        { "$ref": "#/components/parameters/MessageId" }
      ],
      "get": {
        "operationId": "getOwnAiAnswerFeedback",
        "description": "Reads the current authenticated voter's feedback on a completed assistant answer in the owned thread. Cache-Control: no-store.",
        "responses": {
          "200": {
            "description": "Own feedback state or null",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OwnFeedback" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      },
      "put": {
        "operationId": "putOwnAiAnswerFeedback",
        "description": "Creates or updates the single active vote per (messageId, voter). Enforces CSRF on cookie-authenticated mutations. Cache-Control: no-store.",
        "parameters": [
          { "$ref": "#/components/parameters/CsrfTokenHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FeedbackInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted feedback record",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Feedback" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "deleteOwnAiAnswerFeedback",
        "description": "Idempotently removes the current voter's feedback on the target assistant answer. Enforces CSRF on cookie-authenticated mutations. Cache-Control: no-store.",
        "parameters": [
          { "$ref": "#/components/parameters/CsrfTokenHeader" }
        ],
        "responses": {
          "204": {
            "description": "Feedback removed"
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/ai-chat/projects/{projectId}/threads/{threadId}/messages/{messageId}/shares": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ThreadId" },
        { "$ref": "#/components/parameters/MessageId" }
      ],
      "post": {
        "operationId": "createAiAnswerShare",
        "description": "Creates or returns the creator's active Project-scoped share for a single question and completed assistant answer version. Never exposes full thread history, prompt previews, or hidden reasoning. Cache-Control: no-store.",
        "parameters": [
          { "$ref": "#/components/parameters/CsrfTokenHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Empty" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing active share returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Share" }
              }
            }
          },
          "201": {
            "description": "Share created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Share" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/ai-chat/projects/{projectId}/shares/{shareId}": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ShareId" }
      ],
      "get": {
        "operationId": "getAiAnswerShare",
        "description": "Reads a single shared question + assistant answer. Requires ACTIVE Project membership in that exact Project and revalidates current source access; denied, revoked, or cross-scope shares return safe 404. Cache-Control: no-store.",
        "responses": {
          "200": {
            "description": "Sanitized shared question and answer",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SharedAnswer" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "revokeAiAnswerShare",
        "description": "Creator-only revocation of a Project-scoped answer share. Non-creator, missing, or cross-scope shares return safe 404. Cache-Control: no-store.",
        "parameters": [
          { "$ref": "#/components/parameters/CsrfTokenHeader" }
        ],
        "responses": {
          "204": {
            "description": "Share revoked"
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/ai-chat/projects/{projectId}/threads/{threadId}/messages/{messageId}/regenerate": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" },
        { "$ref": "#/components/parameters/ThreadId" },
        { "$ref": "#/components/parameters/MessageId" }
      ],
      "post": {
        "operationId": "regenerateAiChatMessage",
        "description": "SSE regeneration of an assistant answer against its resolved original user question without duplicating the user turn. Excludes the target answer and later turns from generation context while preserving prior answer versions. Returns 409 when another live generation is active in the same thread.",
        "parameters": [
          { "$ref": "#/components/parameters/CsrfTokenHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Empty" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream ending with completed or failed",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/platform/ai/feedback": {
      "get": {
        "operationId": "listPlatformAiAnswerFeedback",
        "x-platform-permission": "platform.ai.operations.read",
        "description": "System Admin (PLATFORM_OPERATOR) telemetry for AI answer likes, dislikes, and dislike reasons. Organization Manager alone is denied. Returns metadata and reasons only (no voter identity, prompt, or private answer content). Totals and items share identical active filters. Cache-Control: no-store.",
        "parameters": [
          {
            "name": "organizationId",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          {
            "name": "rating",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["LIKE", "DISLIKE"]
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered feedback totals and cursor-paginated rows",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminPage" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/ai-chat/projects/{projectId}/mind-map": {
      "parameters": [
        { "$ref": "#/components/parameters/ProjectId" }
      ],
      "get": {
        "operationId": "getAiChatMindMap",
        "description": "Reads the latest persisted Mind Map snapshot for the active Project (optional focus topic) without invoking LLM synthesis. Returns status='ready' (cached=true) when a valid snapshot exists over non-revoked ready sources, status='empty' when no search-ready authorized documents exist, and status='uninitialized' when documents exist but no snapshot has been generated yet.",
        "parameters": [
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "Optional trimmed focus topic (1..200 chars). Omit for the Project-wide overview snapshot."
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted Mind Map snapshot, empty Project state, or uninitialized state",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MindMapResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "generateAiChatMindMap",
        "description": "Generates and persists an on-demand Mind Map (up to 4 levels, max 60 nodes) over authorized search-ready documents in the active Project. Cookie-authenticated calls require X-CSRF-Token. Returns status='empty' when no search-ready authorized documents exist, and generationMode='outline_fallback' only when authorized sources were loaded cleanly but LLM synthesis failed.",
        "parameters": [
          { "$ref": "#/components/parameters/CsrfTokenHeader" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateMindMapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated Mind Map (LLM-synthesized, outline fallback, or empty Project state)",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MindMapResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "504": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "continuum_access"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      },
      "ThreadId": {
        "name": "threadId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      },
      "MessageId": {
        "name": "messageId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      },
      "ShareId": {
        "name": "shareId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      },
      "CsrfTokenHeader": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": false,
        "description": "Required when authenticating with browser cookies on POST, PUT, PATCH, and DELETE mutations.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Safe standardized error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Thread": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateThread": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "UpdateThread": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "Ask": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "Citation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "sourceId", "documentId"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "sourceId": { "type": "string" },
          "sourceName": { "type": "string" },
          "documentId": { "type": "string" },
          "sagDocumentId": { "type": "string" },
          "documentName": { "type": "string" },
          "chunkId": { "type": "string" },
          "sectionPath": { "type": "string" },
          "versionNo": { "type": "integer", "minimum": 1 },
          "heading": { "type": "string" },
          "snippet": { "type": "string" },
          "label": { "type": "string" },
          "pageFrom": { "type": "integer", "minimum": 1 },
          "pageTo": { "type": "integer", "minimum": 1 },
          "mapped": { "type": "boolean" },
          "claimLevel": {
            "type": "string",
            "enum": ["claim", "run"]
          }
        }
      },
      "SessionCitation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "source", "turnIds", "summaryExcerpt"],
        "properties": {
          "ref": { "type": "string", "pattern": "^S[1-9][0-9]*$" },
          "source": {
            "type": "string",
            "enum": ["selected_group", "recent_continuity"]
          },
          "groupId": { "type": ["string", "null"] },
          "turnIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "turnRange": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 }
          },
          "summaryExcerpt": { "type": "string" },
          "mapped": { "type": "boolean" },
          "claimLevel": {
            "type": "string",
            "enum": ["claim", "run"]
          }
        }
      },
      "RetrievalStep": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label", "durationMs"],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["running", "completed", "failed"]
          },
          "kind": {
            "type": "string",
            "enum": ["session_context", "tool", "thinking", "answer"]
          },
          "label": { "type": "string" },
          "durationMs": { "type": "integer", "minimum": 0 },
          "count": { "type": "integer", "minimum": 0 },
          "mode": { "type": "string" }
        }
      },
      "Message": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "content",
          "status",
          "citations",
          "sessionCitations",
          "retrievalSteps",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string" },
          "replyToMessageId": { "type": "string" },
          "regeneratedFromMessageId": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["user", "assistant"]
          },
          "content": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["ok", "failed", "cancelled"]
          },
          "citations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Citation" }
          },
          "sessionCitations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SessionCitation" }
          },
          "retrievalSteps": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RetrievalStep" }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "MessagePage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["items", "nextCursor", "hasMore"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Message" }
          },
          "nextCursor": { "type": ["string", "null"] },
          "hasMore": { "type": "boolean" }
        }
      },
      "StartedEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "threadId"],
        "properties": {
          "runId": { "type": "string" },
          "threadId": { "type": "string" },
          "userMessageId": { "type": "string" }
        }
      },
      "StepEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "label", "durationMs"],
        "properties": {
          "id": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["running", "completed", "failed"]
          },
          "kind": {
            "type": "string",
            "enum": ["session_context", "tool", "thinking", "answer"]
          },
          "label": { "type": "string" },
          "durationMs": { "type": "integer", "minimum": 0 },
          "count": { "type": "integer", "minimum": 0 },
          "mode": { "type": "string" }
        }
      },
      "DeltaEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string" }
        }
      },
      "CompletedEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "messageId",
          "content",
          "answerStatus",
          "citations",
          "sessionCitations",
          "retrievalSteps"
        ],
        "properties": {
          "messageId": { "type": "string" },
          "replyToMessageId": { "type": "string" },
          "regeneratedFromMessageId": { "type": "string" },
          "content": { "type": "string" },
          "answerStatus": {
            "type": "string",
            "enum": ["answered", "no_answer"]
          },
          "citations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Citation" }
          },
          "sessionCitations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SessionCitation" }
          },
          "retrievalSteps": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RetrievalStep" }
          }
        }
      },
      "FailedEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "retryable": { "type": "boolean" },
          "messageId": { "type": "string" },
          "replyToMessageId": { "type": "string" },
          "regeneratedFromMessageId": { "type": "string" }
        }
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "FeedbackInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rating"],
        "properties": {
          "rating": {
            "type": "string",
            "enum": ["LIKE", "DISLIKE"]
          },
          "reasonCategory": {
            "type": "string",
            "enum": [
              "INACCURATE",
              "OUTDATED",
              "IRRELEVANT_CITATION",
              "INCOMPLETE",
              "OTHER"
            ]
          },
          "reasonText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "rating": {
                  "const": "DISLIKE"
                }
              }
            },
            "then": {
              "required": [
                "reasonCategory"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "rating": {
                  "const": "LIKE"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "reasonCategory"
                    ]
                  },
                  {
                    "required": [
                      "reasonText"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "reasonCategory"
              ],
              "properties": {
                "reasonCategory": {
                  "const": "OTHER"
                }
              }
            },
            "then": {
              "required": [
                "reasonText"
              ]
            }
          }
        ]
      },
      "Feedback": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messageId", "rating", "updatedAt"],
        "properties": {
          "messageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "rating": {
            "type": "string",
            "enum": ["LIKE", "DISLIKE"]
          },
          "reasonCategory": {
            "type": "string",
            "enum": [
              "INACCURATE",
              "OUTDATED",
              "IRRELEVANT_CITATION",
              "INCOMPLETE",
              "OTHER"
            ]
          },
          "reasonText": {
            "type": "string",
            "maxLength": 1000
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OwnFeedback": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feedback"],
        "properties": {
          "feedback": {
            "oneOf": [
              { "$ref": "#/components/schemas/Feedback" },
              { "type": "null" }
            ]
          }
        }
      },
      "Share": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "projectId", "messageId", "createdAt"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "messageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PublicAnswer": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content", "citations"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "content": { "type": "string" },
          "citations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Citation" }
          }
        }
      },
      "SharedAnswer": {
        "type": "object",
        "additionalProperties": false,
        "required": ["share", "question", "answer"],
        "properties": {
          "share": { "$ref": "#/components/schemas/Share" },
          "question": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content"],
            "properties": {
              "content": { "type": "string" }
            }
          },
          "answer": { "$ref": "#/components/schemas/PublicAnswer" }
        }
      },
      "AdminRow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organizationId",
          "projectId",
          "messageId",
          "rating",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "messageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "rating": {
            "type": "string",
            "enum": ["LIKE", "DISLIKE"]
          },
          "reasonCategory": {
            "type": "string",
            "enum": [
              "INACCURATE",
              "OUTDATED",
              "IRRELEVANT_CITATION",
              "INCOMPLETE",
              "OTHER"
            ]
          },
          "reasonText": {
            "type": "string",
            "maxLength": 1000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminPage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["totals", "items", "nextCursor"],
        "properties": {
          "totals": {
            "type": "object",
            "additionalProperties": false,
            "required": ["likes", "dislikes"],
            "properties": {
              "likes": { "type": "integer", "minimum": 0 },
              "dislikes": { "type": "integer", "minimum": 0 }
            }
          },
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/AdminRow" }
          },
          "nextCursor": {
            "type": ["string", "null"],
            "maxLength": 1024
          }
        }
      },
      "GenerateMindMapRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Optional trimmed focus topic (1..200 non-whitespace chars). Omit for a Project-wide overview Mind Map."
          },
          "refresh": {
            "type": "boolean",
            "default": true,
            "description": "When true (default), synthesizes and overwrites the Project snapshot; when false, returns an existing valid snapshot if present before synthesizing."
          }
        }
      },
      "MindMapCoverage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accessibleReadyDocumentCount",
          "usedDocumentCount",
          "omittedDocumentCount",
          "pendingDocumentCount",
          "truncatedDocumentCount",
          "evidenceUnitCount"
        ],
        "properties": {
          "accessibleReadyDocumentCount": { "type": "integer", "minimum": 0 },
          "usedDocumentCount": { "type": "integer", "minimum": 0 },
          "omittedDocumentCount": { "type": "integer", "minimum": 0 },
          "pendingDocumentCount": { "type": "integer", "minimum": 0 },
          "truncatedDocumentCount": { "type": "integer", "minimum": 0 },
          "evidenceUnitCount": { "type": "integer", "minimum": 0 }
        }
      },
      "MindMapNode": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "summary", "citationNumbers", "children"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "summary": {
            "type": ["string", "null"],
            "maxLength": 320
          },
          "citationNumbers": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "uniqueItems": true,
            "description": "Supporting citation numbers from the authorized input set; proves source membership only, not semantic faithfulness."
          },
          "children": {
            "type": "array",
            "maxItems": 8,
            "items": { "$ref": "#/components/schemas/MindMapNode" }
          }
        }
      },
      "MindMapResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "topic",
          "status",
          "generationMode",
          "fallbackReason",
          "scopeFingerprint",
          "coverage",
          "tree",
          "citations",
          "generatedAt"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "topic": {
            "type": ["string", "null"],
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": ["ready", "empty", "uninitialized"]
          },
          "generationMode": {
            "type": "string",
            "enum": ["llm", "outline_fallback", "none"]
          },
          "fallbackReason": {
            "type": ["string", "null"],
            "enum": ["LLM_UNAVAILABLE", "LLM_INVALID_OUTPUT", null]
          },
          "scopeFingerprint": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "cached": {
            "type": "boolean",
            "description": "True when served directly from a persisted Project snapshot without re-running synthesis."
          },
          "hasSourceUpdates": {
            "type": "boolean",
            "description": "True when additional authorized ready documents exist beyond the persisted snapshot's scopeFingerprint."
          },
          "coverage": {
            "$ref": "#/components/schemas/MindMapCoverage"
          },
          "tree": {
            "oneOf": [
              { "$ref": "#/components/schemas/MindMapNode" },
              { "type": "null" }
            ]
          },
          "citations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Citation" }
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message", "details", "requestId"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "details": { "type": "object" },
          "requestId": { "type": ["string", "null"] }
        }
      }
    }
  }
}
