{
  "openapi": "3.1.0",
  "info": {
    "title": "Continuum AI IAM API",
    "version": "1.0.0-draft",
    "description": "Review-first contract for authentication, users, projects, project memberships, teams and team memberships. Login, current user, logout and user directory are implemented. Other operations, including refresh, remain proposed. Browser authentication uses an HttpOnly access cookie; bearer access is supported for trusted clients. Access tokens are never returned in browser JSON responses."
  },
  "tags": [
    { "name": "Auth", "description": "Authentication and session rotation." },
    { "name": "Users", "description": "Organization user directory." },
    { "name": "Projects", "description": "Organization projects." },
    {
      "name": "Project Memberships",
      "description": "User access to projects."
    },
    { "name": "Teams", "description": "Teams within a project." },
    { "name": "Team Memberships", "description": "User membership in teams." }
  ],
  "security": [{ "bearerAuth": [] }, { "cookieAuth": [] }],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in",
        "description": "Authenticates an active user, sets continuum_access as an HttpOnly cookie and returns the selected user identity. If the verified account belongs to multiple organizations, returns 409 with eligible organization names and IDs. Invalid credentials use a generic response.",
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication succeeded.",
            "headers": {
              "Set-Cookie": {
                "description": "continuum_access; HttpOnly; SameSite=Strict; Path=/; Max-Age=900 (Secure outside local development).",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/OrganizationSelectionRequired" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Rotate a session token pair",
        "description": "Proposed, not implemented. Session rotation is outside the current authentication slice and requires a separate contract review before implementation.",
        "operationId": "refreshSession",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshSessionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token pair rotated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthSession" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log out the current session",
        "description": "Revokes the presented access token, clears the access cookie and returns an idempotent confirmation.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Session logged out.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LogoutResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get the current user",
        "description": "Loads the active user from a valid cookie or bearer access token.",
        "operationId": "getCurrentIdentity",
        "security": [{ "cookieAuth": [] }, { "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user identity.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CurrentUser" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v1/iam/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "description": "Returns users visible in the caller's organization scope.",
        "operationId": "listUsers",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/UserStatus" }
          },
          {
            "name": "roleCode",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/RoleCode" }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of users.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/iam/users/{userId}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get a user",
        "operationId": "getUser",
        "parameters": [{ "$ref": "#/components/parameters/UserId" }],
        "responses": {
          "200": {
            "description": "The requested user.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update a user",
        "description": "Updates mutable profile or account-status fields. Only an organization Admin may change status.",
        "operationId": "updateUser",
        "parameters": [{ "$ref": "#/components/parameters/UserId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/iam/projects": {
      "get": {
        "tags": ["Projects"],
        "summary": "List projects",
        "description": "Returns Project metadata visible to the authenticated User in the trusted Organization. Users with an ACTIVE Organization Membership may read PUBLIC Project metadata; PRIVATE Projects require the documented Project read policy. Organization Admins may list all organization Projects. Nested Project resources are outside this endpoint contract.",
        "operationId": "listProjects",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/ProjectStatus" }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of projects.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProjectList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "post": {
        "tags": ["Projects"],
        "summary": "Create a project",
        "description": "Any authenticated User with an ACTIVE Organization Membership in the trusted Organization Context may create a Project in that Organization. New Projects are PRIVATE. An ADMIN or TEAM_LEADER role and a project.create capability grant are not required. Creation bootstraps the creator as an ACTIVE ProjectMembership with a project-scoped MEMBER RoleAssignment, but does not make the creator a Project Leader, owner, or Team. A provisioned current MEMBER Role with project.read is required for the bootstrap; the Project, membership, assignment, and project.create audit event are committed atomically.",
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProjectRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/iam/projects/{projectId}": {
      "get": {
        "tags": ["Projects"],
        "summary": "Get a project",
        "description": "Returns Project metadata when the authenticated User has visibility in the trusted Organization. An ACTIVE Organization member may read PUBLIC Project metadata. PRIVATE Projects require the documented Project read policy. Nested Project resources are outside this endpoint contract.",
        "operationId": "getProject",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "responses": {
          "200": {
            "description": "The requested project.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "patch": {
        "tags": ["Projects"],
        "summary": "Update a project",
        "operationId": "updateProject",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProjectRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/iam/projects/{projectId}/memberships": {
      "get": {
        "tags": ["Project Memberships"],
        "summary": "List project memberships",
        "operationId": "listProjectMemberships",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" },
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/MembershipStatus" }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of project memberships.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectMembershipList"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "post": {
        "tags": ["Project Memberships"],
        "summary": "Add a project member",
        "description": "Creates an active project membership for an organization user.",
        "operationId": "createProjectMembership",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectMembershipRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project membership created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProjectMembership" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/iam/projects/{projectId}/memberships/{membershipId}": {
      "patch": {
        "tags": ["Project Memberships"],
        "summary": "Update a project membership",
        "operationId": "updateProjectMembership",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/MembershipId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProjectMembershipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project membership updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProjectMembership" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "delete": {
        "tags": ["Project Memberships"],
        "summary": "Remove a project membership",
        "description": "Idempotently removes the membership from the active project view. The containing project must exist. Active team memberships for the same user cause a conflict and must be removed first.",
        "operationId": "deleteProjectMembership",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/MembershipId" }
        ],
        "responses": {
          "204": {
            "description": "Membership is absent from the active project view."
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/iam/projects/{projectId}/teams": {
      "get": {
        "tags": ["Teams"],
        "summary": "List project teams",
        "operationId": "listTeams",
        "parameters": [
          { "$ref": "#/components/parameters/ProjectId" },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": {
            "description": "A page of teams.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TeamList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "post": {
        "tags": ["Teams"],
        "summary": "Create a team",
        "operationId": "createTeam",
        "parameters": [{ "$ref": "#/components/parameters/ProjectId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTeamRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Team created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Team" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/iam/teams/{teamId}": {
      "get": {
        "tags": ["Teams"],
        "summary": "Get a team",
        "operationId": "getTeam",
        "parameters": [{ "$ref": "#/components/parameters/TeamId" }],
        "responses": {
          "200": {
            "description": "The requested team.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Team" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
