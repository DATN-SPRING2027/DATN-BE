  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "continuum_access",
        "description": "HttpOnly browser access cookie."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Short-lived access token issued by the login or refresh operation."
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "default": 1, "minimum": 1 }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100
        }
      },
      "UserId": {
        "name": "userId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ResourceId" }
      },
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ResourceId" }
      },
      "TeamId": {
        "name": "teamId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ResourceId" }
      },
      "MembershipId": {
        "name": "membershipId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ResourceId" }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication is missing, invalid, expired or revoked.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated caller lacks permission for the requested scope.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "The addressed resource does not exist or is not visible to the caller.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with an existing unique resource or current state. User status updates can return LAST_ACTIVE_ADMIN or SHARED_ACCOUNT_STATUS_CHANGE.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "OrganizationSelectionRequired": {
        "description": "The password was verified, but an organization must be selected. The details.organizations array contains only organizations assigned to this account.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/OrganizationSelectionError" }
          }
        }
      },
      "ValidationFailed": {
        "description": "The JSON request is understood but violates field or business validation.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "TooManyRequests": {
        "description": "The request exceeded the applicable rate limit.",
        "headers": {
          "Retry-After": {
            "description": "Seconds until the caller may retry.",
            "schema": { "type": "integer", "minimum": 1 }
          },
          "X-RateLimit-Limit": {
            "description": "Maximum requests in the current window.",
            "schema": { "type": "integer", "minimum": 1 }
          },
          "X-RateLimit-Remaining": {
            "description": "Requests remaining in the current window.",
            "schema": { "type": "integer", "minimum": 0 }
          },
          "X-RateLimit-Reset": {
            "description": "UTC Unix timestamp when the current window resets.",
            "schema": { "type": "integer", "minimum": 0 }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "ResourceId": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque resource identifier. Clients must not infer its storage format."
      },
      "UtcTimestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$",
        "description": "ISO-8601 timestamp normalized to UTC with a trailing Z."
      },
      "RoleCode": {
        "type": "string",
        "enum": ["ADMIN", "TEAM_LEADER", "MEMBER"]
      },
      "UserStatus": {
        "type": "string",
        "enum": ["ACTIVE", "SUSPENDED", "PENDING_INVITE"]
      },
      "ProjectStatus": {
        "type": "string",
        "enum": ["ACTIVE", "ARCHIVED"]
      },
      "MembershipStatus": {
        "type": "string",
        "enum": ["ACTIVE", "INACTIVE"]
      },
      "Pagination": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "pageSize", "totalItems", "totalPages"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
          "totalItems": { "type": "integer", "minimum": 0 },
          "totalPages": { "type": "integer", "minimum": 0 }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "details", "requestId"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "details": {
            "type": "object",
            "description": "Machine-readable context. Use an empty object when no additional context is safe to expose.",
            "additionalProperties": true
          },
          "requestId": { "type": "string", "minLength": 1 }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "maxLength": 320 },
          "organizationId": { "$ref": "#/components/schemas/ResourceId" },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "writeOnly": true
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "email", "name", "organizationId", "roles"],
        "properties": {
          "id": { "$ref": "#/components/schemas/ResourceId" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string", "minLength": 1 },
          "organizationId": { "$ref": "#/components/schemas/ResourceId" },
          "roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user"],
        "properties": {
          "user": { "$ref": "#/components/schemas/CurrentUser" }
        }
      },
      "LogoutResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "const": "logged_out" }
        }
      },
      "OrganizationSelectionError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "details", "requestId"],
        "properties": {
          "code": { "type": "string", "const": "ORGANIZATION_SELECTION_REQUIRED" },
          "message": { "type": "string" },
          "details": {
            "type": "object",
            "additionalProperties": false,
            "required": ["organizations"],
            "properties": {
              "organizations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "name"],
                  "properties": {
                    "id": { "$ref": "#/components/schemas/ResourceId" },
                    "name": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "requestId": { "type": "string" }
        }
      },
      "RefreshSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          }
        }
      },
      "TokenPair": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accessToken", "refreshToken", "tokenType", "expiresIn"],
        "properties": {
          "accessToken": { "type": "string", "minLength": 1 },
          "refreshToken": { "type": "string", "minLength": 1 },
          "tokenType": { "type": "string", "const": "Bearer" },
          "expiresIn": {
            "type": "integer",
            "minimum": 1,
            "description": "Access-token lifetime in seconds."
          }
        }
      },
      "AuthSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tokens", "user"],
        "properties": {
          "tokens": { "$ref": "#/components/schemas/TokenPair" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "email",
          "fullName",
          "status",
          "roleCodes",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "format": "email" },
          "fullName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "avatarUrl": { "type": ["string", "null"], "format": "uri" },
          "status": { "$ref": "#/components/schemas/UserStatus" },
          "roleCodes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RoleCode" },
            "uniqueItems": true
          },
          "lastLoginAt": {
            "oneOf": [
              { "$ref": "#/components/schemas/UtcTimestamp" },
              { "type": "null" }
            ]
          },
          "createdAt": { "$ref": "#/components/schemas/UtcTimestamp" },
          "updatedAt": { "$ref": "#/components/schemas/UtcTimestamp" }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "fullName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "avatarUrl": { "type": ["string", "null"], "format": "uri" },
          "status": { "$ref": "#/components/schemas/UserStatus" }
        }
      },
      "UserList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "pagination"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/User" }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "Project": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organizationId",
          "name",
          "code",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "organizationId": { "$ref": "#/components/schemas/ResourceId" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,31}$" },
          "description": { "type": ["string", "null"], "maxLength": 2000 },
          "status": { "$ref": "#/components/schemas/ProjectStatus" },
          "createdBy": { "$ref": "#/components/schemas/ResourceId" },
          "createdAt": { "$ref": "#/components/schemas/UtcTimestamp" },
          "updatedAt": { "$ref": "#/components/schemas/UtcTimestamp" }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "code"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,31}$" },
          "description": { "type": "string", "maxLength": 2000 }
        }
      },
      "UpdateProjectRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": ["string", "null"], "maxLength": 2000 },
          "status": { "$ref": "#/components/schemas/ProjectStatus" }
        }
      },
      "ProjectList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "pagination"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Project" }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "ProjectMembership": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organizationId",
          "projectId",
          "userId",
          "status",
          "joinedAt"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "organizationId": { "$ref": "#/components/schemas/ResourceId" },
          "projectId": { "$ref": "#/components/schemas/ResourceId" },
          "userId": { "$ref": "#/components/schemas/ResourceId" },
          "status": { "$ref": "#/components/schemas/MembershipStatus" },
          "joinedAt": { "$ref": "#/components/schemas/UtcTimestamp" }
        }
      },
      "CreateProjectMembershipRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userId"],
        "properties": {
          "userId": { "$ref": "#/components/schemas/ResourceId" }
        }
      },
      "UpdateProjectMembershipRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/MembershipStatus" }
        }
      },
      "ProjectMembershipList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "pagination"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProjectMembership" }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "Team": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organizationId",
          "projectId",
          "name",
          "code",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "organizationId": { "$ref": "#/components/schemas/ResourceId" },
          "projectId": { "$ref": "#/components/schemas/ResourceId" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,31}$" },
          "description": { "type": ["string", "null"], "maxLength": 2000 },
          "createdAt": { "$ref": "#/components/schemas/UtcTimestamp" },
          "updatedAt": { "$ref": "#/components/schemas/UtcTimestamp" }
        }
      },
      "CreateTeamRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "code"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,31}$" },
          "description": { "type": "string", "maxLength": 2000 }
        }
      },
      "UpdateTeamRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": ["string", "null"], "maxLength": 2000 }
        }
      },
      "TeamList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "pagination"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Team" }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "TeamMembership": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organizationId",
          "projectId",
          "teamId",
          "userId",
          "joinedAt"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "organizationId": { "$ref": "#/components/schemas/ResourceId" },
          "projectId": { "$ref": "#/components/schemas/ResourceId" },
          "teamId": { "$ref": "#/components/schemas/ResourceId" },
          "userId": { "$ref": "#/components/schemas/ResourceId" },
          "joinedAt": { "$ref": "#/components/schemas/UtcTimestamp" }
        }
      },
      "CreateTeamMembershipRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userId"],
        "properties": {
          "userId": { "$ref": "#/components/schemas/ResourceId" }
        }
      },
      "TeamMembershipList": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "pagination"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TeamMembership" }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      }
    }
  }
}
