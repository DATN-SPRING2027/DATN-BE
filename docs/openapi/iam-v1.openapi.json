      "patch": {
        "tags": ["Teams"],
        "summary": "Update a team",
        "operationId": "updateTeam",
        "parameters": [{ "$ref": "#/components/parameters/TeamId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTeamRequest" }
            }
          }
